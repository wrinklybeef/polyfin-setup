# Generate once with: openssl rand -hex 32
# Keep this key with your backups; do not regenerate it during updates.
POLYFIN_SECRET_KEY=

# Replace with a hostname in your Cloudflare-managed zone.
POLYFIN_DOMAIN=tv.example.com

# Cloudflare token: Zone DNS Edit + Zone Read, scoped to your zone.
CLOUDFLARE_API_TOKEN=
